{
  "name": "vacation-planner/api",
  "description": "PHP API for Vacation Planner: one shared plan with edit and view keys",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "VacationPlanner\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VacationPlanner\\Api\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
